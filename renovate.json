{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:enableMajor", ":maintainLockFilesWeekly", "group:all"],
  "timezone": "Asia/Shanghai",
  "commitMessagePrefix": "deps:",
  "cloneSubmodules": true,
  "packageRules": [
    {
      "description": "Match the local pnpm minimum release age.",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "The interop reference names anytls-go through a replace directive; the placeholder module has no upstream.",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["anytls"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update versioned Cargo tools installed in Docker builds.",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "cargo install (?<depName>[a-zA-Z0-9_-]+) --version (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "crate",
      "versioningTemplate": "semver"
    }
  ]
}
