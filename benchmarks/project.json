{
  "name": "benchmarks",
  "implicitDependencies": ["e2e", "python"],
  "targets": {
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked python benchmarks/run.py"
      },
      "dependsOn": [
        {
          "projects": ["docker"],
          "target": "release",
          "params": "ignore"
        }
      ],
      "parallelism": false
    },
    "udp-churn": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked python benchmarks/check_udp_churn.py"
      },
      "dependsOn": [
        {
          "projects": ["docker"],
          "target": "release",
          "params": "ignore"
        }
      ],
      "parallelism": false
    },
    "smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked python benchmarks/run.py --binary target/tun/debug/kotoconn --traffic-binary target/tun/debug/kotoconn-tun-traffic --mtu 1500 --duration 1 --warmup 0 --repetitions 1 --case tcp-bulk-1 --case udp-paced --case mixed-malformed"
      },
      "dependsOn": [
        {
          "projects": ["docker"],
          "target": "build",
          "params": "ignore"
        }
      ],
      "parallelism": false
    },
    "udp-churn-smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run --locked python benchmarks/check_udp_churn.py --binary target/tun/debug/kotoconn --traffic-binary target/tun/debug/kotoconn-tun-traffic"
      },
      "dependsOn": [
        {
          "projects": ["docker"],
          "target": "build",
          "params": "ignore"
        }
      ],
      "parallelism": false
    },
    "check": {
      "executor": "nx:noop",
      "dependsOn": ["smoke", "udp-churn-smoke"]
    }
  }
}
