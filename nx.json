{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-workspace.yaml",
      "{workspaceRoot}/mise.toml",
      "{workspaceRoot}/mise.lock",
      {
        "runtime": "node --version"
      }
    ],
    "rust": [
      "rustSources",
      {
        "runtime": "rustc --version --verbose"
      },
      {
        "env": "RUSTFLAGS"
      },
      {
        "runtime": "git -C external/smoltcp rev-parse HEAD"
      },
      {
        "env": "KOTOCONN_RUST_TARGET"
      },
      {
        "runtime": "cargo-zigbuild --version"
      },
      {
        "runtime": "zig version"
      },
      {
        "env": "CARGO_ENCODED_RUSTFLAGS"
      }
    ],
    "rustSources": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/crates/**/*",
      "{workspaceRoot}/external/smoltcp/**/*"
    ],
    "pythonSources": [
      "{workspaceRoot}/e2e/**/*.py",
      "{workspaceRoot}/benchmarks/**/*.py",
      "{workspaceRoot}/tools/**/*.py",
      "{workspaceRoot}/pyproject.toml",
      "{workspaceRoot}/uv.lock",
      "{workspaceRoot}/.python-version"
    ]
  },
  "targetDefaults": {
    "nx:run-commands": {
      "cache": false,
      "inputs": ["default", "^default"]
    }
  }
}
