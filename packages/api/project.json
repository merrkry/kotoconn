{
  "name": "@kotoconn/api",
  "implicitDependencies": ["@kotoconn/bindings"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/api/tsconfig.json"
      },
      "dependsOn": [
        {
          "projects": ["@kotoconn/bindings"],
          "target": "generate",
          "params": "ignore"
        }
      ],
      "cache": true,
      "inputs": ["default", "^default", "rust"],
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/api/tsconfig.json --noEmit && tsc -p packages/api/examples/tsconfig.json"
      },
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["default", "^default", "rust"]
    }
  }
}
